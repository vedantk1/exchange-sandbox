{
  "name": "spot-exchange-simulator",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "tsx scripts/with-postgres.ts test",
    "test:integration:external": "vitest run --config vitest.integration.config.ts",
    "test:browser": "tsx scripts/with-postgres.ts browser",
    "test:browser:external": "playwright test",
    "demo": "tsx scripts/with-postgres.ts demo",
    "build:web": "pnpm --filter @sandbox/web build",
    "check": "pnpm typecheck && pnpm format:check && pnpm test && pnpm test:integration && pnpm build:web && pnpm test:browser",
    "dev": "tsx scripts/with-postgres.ts dev",
    "admin:setup": "tsx scripts/with-postgres.ts setup",
    "admin:reset": "tsx scripts/with-postgres.ts reset",
    "selfhost:prepare": "tsx scripts/deploy/prepare.ts",
    "ops:benchmark": "tsx scripts/with-postgres.ts benchmark",
    "ops:benchmark:session": "tsx scripts/with-postgres.ts large-session-benchmark",
    "ops:benchmark:charts": "tsx scripts/with-postgres.ts benchmark-candles",
    "ops:restore": "tsx scripts/with-postgres.ts restore"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
